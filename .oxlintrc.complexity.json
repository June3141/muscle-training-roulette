{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "perf": "off",
    "pedantic": "off",
    "style": "off"
  },
  "rules": {
    "complexity": ["error", { "max": 12 }],
    "eslint/max-depth": ["error", { "max": 3 }],
    "eslint/max-params": ["error", { "max": 4 }],
    "eslint/max-lines-per-function": ["error", { "max": 60, "skipComments": true }],
    "eslint/max-statements": ["error", { "max": 25 }],
    "eslint/max-nested-callbacks": ["error", { "max": 3 }]
  },
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "data/upstream/**"],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/test/**/*.ts"],
      "rules": {
        "eslint/max-lines-per-function": "off",
        "eslint/max-statements": "off",
        "eslint/max-nested-callbacks": ["error", { "max": 5 }]
      }
    }
  ]
}
